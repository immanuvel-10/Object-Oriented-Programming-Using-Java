package JavaApplication;
import java.util.Scanner;
 class Salary {
    String emp_name,mail_id,address,designation;
    int emp_id,mobile_no;
    double bp,da,hra,gp,pf,staff,np;
    public void input(){
        Scanner sc=new Scanner(System.in);
        System.out.println("Enter the employee name:");
        emp_name=sc.nextLine();
         System.out.println("Enter the employee address:");
        address=sc.nextLine();
         System.out.println("Enter the employee mail id:");
        mail_id=sc.nextLine();
        System.out.println("Enter the employee id:");
        emp_id=sc.nextInt();
        System.out.println("Enter the employee mobile no:");
        mobile_no=sc.nextInt();
        System.out.println("Enter the employee basic pay");
        bp=sc.nextDouble();
       
    }
    public void output(){
        System.out.println("Employees nmae:"+emp_name);
        System.out.println("Employee id:"+emp_id);
        System.out.println("Employee adress:"+address);
        System.out.println("Employee mail id:"+mail_id);
        System.out.println("Employee mobile no:"+mobile_no);
        System.out.println("Employee basic pay:"+bp);
        System.out.println("Employee dearness alavence:"+da);
        System.out.println("Employee house rent alavence:"+hra);
        System.out.println("Employee Gross pay:"+gp);
        System.out.println("Employee provident fund:"+pf);
        System.out.println("Employee STaff club pay:"+staff);
        System.out.println("Employee Net pay:"+np);
    }
   
}
class Programmer extends Salary{
Programmer(){
    designation="Programmer";
}
public void programmersalary(){
    da=bp*0.97;
    hra=bp*0.1;
    gp=bp+da+hra;
    pf=bp*0.12;
    staff=bp*0.1;
    np=gp-(pf+staff);
   
}
}
class AssistantProfessor extends Salary{
AssistantProfessor(){
    designation="AssistantProfessor";
}
public void AssistantProfessorsalary(){
    da=bp*(110/100);
    hra=bp*0.20;
    gp=bp+da+hra;
    pf=bp*0.12;
    staff=bp*0.5;
    np=gp-(pf+staff);
   
}
}
class AssociateProfessor extends Salary{
AssociateProfessor(){
    designation="AssosciateProfessor";
}
public void AssociateProfessorsalary(){
    da=bp*(130/100);
    hra=bp*0.3;
    gp=bp+da+hra;
    pf=bp*0.12;
    staff=bp*0.1;
    np=gp-(pf+staff);
   
}
}
class Professor extends Salary{
Professor(){
    designation="Professor";
}
public void professorsalary(){
    da=bp*(140/100);
    hra=bp*0.4;
    gp=bp+da+hra;
    pf=bp*0.12;
    staff=bp*0.15;
    np=gp-(pf+staff);
   
}
}


class JavaApplication13{
    public static void main(String[]args){
        Programmer pg=new Programmer();
        AssistantProfessor asp=new AssistantProfessor ();
        AssociateProfessor aop=new AssociateProfessor ();
        Professor ps=new Professor ();
        Scanner sc=new Scanner(System.in);
        System.out.println("Enter the DESIGNATION:");
        String choice=sc.nextLine();
        switch(choice)
        {
            case "Programmer":
                pg.input();
                if (pg.bp>=15000&&pg.bp<=20000)
                {
                    pg.programmersalary();
                    pg.output();
               
                }
                else
                    System.out.println("Invalid Salary");
       
            case "AssistantProfessor":
                asp.input();
                if (asp.bp>=20001&&asp.bp<=30001)
                {
                    asp.AssistantProfessorsalary();
                    asp.output();
               
                }
                else
                    System.out.println("Invalid Salary");
           
            case "AssociateProfessor":
                aop.input();
                if (aop.bp>=20001&&aop.bp<=30001)
                {
                    aop.AssociateProfessorsalary();
                    aop.output();
               
                }
                else
                    System.out.println("Invalid Salary");
           
            case "Professor":
                ps.input();
                if (ps.bp>40000)
                {
                    ps.professorsalary();
                    ps.output();
               
                }
                else
                    System.out.println("Invalid Salary");
           
            default:
                System.out.println("Invalid salary");
        }
    }
}
